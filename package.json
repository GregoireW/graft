{
  "name": "graft",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.14.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:perf": "GRAFT_PERF=1 vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "dev:server": "tsx watch --import ./src/bin/otel.ts src/bin/server.ts",
    "dev:worker": "tsx watch --import ./src/bin/otel.ts src/bin/worker.ts",
    "start:server": "node --import ./dist/bin/otel.js dist/bin/server.js",
    "start:worker": "node --import ./dist/bin/otel.js dist/bin/worker.js",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "tsx src/bin/migrate.ts up",
    "db:rollback": "tsx src/bin/migrate.ts down",
    "db:status": "tsx src/bin/migrate.ts status",
    "webhook:send": "tsx scripts/send-webhook.ts",
    "tunnel": "smee --url \"$SMEE_URL\" --target \"http://localhost:${PORT:-3000}/webhooks/github\"",
    "eval": "tsx src/bin/eval.ts",
    "eval:ci": "tsx src/bin/eval.ts run --set eval/synthetic --baseline eval/baselines/synthetic.json --check",
    "graft": "tsx src/bin/graft.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fastify/otel": "1.0.1",
    "@google/genai": "^2.32.0",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@octokit/app": "^16.1.4",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "@octokit/webhooks-methods": "^6.0.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "0.301.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.301.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.301.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.301.0",
    "@opentelemetry/instrumentation": "0.301.0",
    "@opentelemetry/instrumentation-pg": "0.78.0",
    "@opentelemetry/instrumentation-undici": "0.35.0",
    "@opentelemetry/resources": "3.1.0",
    "@opentelemetry/sdk-metrics": "3.1.0",
    "@opentelemetry/sdk-node": "0.301.0",
    "@opentelemetry/sdk-trace": "3.1.0",
    "fastify": "^5.12.7",
    "kysely": "^0.29.6",
    "openai": "^7.32.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "picomatch": "^4.0.7",
    "pino": "^10.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@modelcontextprotocol/client": "2.3.1",
    "@octokit/webhooks-examples": "^7.6.1",
    "@octokit/webhooks-schemas": "^7.6.1",
    "@opentelemetry/context-async-hooks": "3.1.0",
    "@opentelemetry/core": "3.1.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/picomatch": "^4.0.3",
    "ajv": "^8.20.0",
    "smee-client": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
